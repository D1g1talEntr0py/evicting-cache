{
  "name": "evicting-cache",
  "author": "D1g1talEntr0py",
  "version": "3.0.7",
  "license": "ISC",
  "description": "Cache implementation with an LRU evicting policy",
  "homepage": "https://github.com/D1g1talEntr0py/evicting-cache#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/D1g1talEntr0py/evicting-cache"
  },
  "bugs": {
    "url": "https://github.com/D1g1talEntr0py/evicting-cache/issues"
  },
  "maintainers": [
    {
      "name": "D1g1talEntr0py",
      "email": "jason.dimeo@gmail.com"
    }
  ],
  "engines": {
    "node": ">=20.16.0"
  },
  "packageManager": "pnpm@12.14.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "types": "./dist/evicting-cache.d.ts",
  "exports": {
    ".": {
      "types": "./dist/evicting-cache.d.ts",
      "import": "./dist/evicting-cache.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && terser dist/evicting-cache.js --module --compress --mangle --output dist/evicting-cache.js --source-map \"content='dist/evicting-cache.js.map',url='evicting-cache.js.map'\"",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config ./src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-jsdoc": "^65.3.8",
    "terser": "^5.51.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "defaults and fully supports es6",
    "maintained node versions"
  ],
  "keywords": [
    "cache",
    "evicting-cache",
    "lru",
    "lru-cache",
    "evicting-lru-cache"
  ]
}
