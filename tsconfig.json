{
	"compilerOptions": {
		"target": "ES2024",
		"outDir": "./dist",
		"strict": true,
		"sourceMap": true,
		"declaration": true,
		"verbatimModuleSyntax": true,
		"allowUnusedLabels": false,
		"allowUnreachableCode": false,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,
		"rootDir": "./src",
		"lib": [ "ES2024", "DOM" ],
		"module": "preserve"
	},
	"include": [ "./src" ]
}